# ── Base de datos ──────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Ejemplo local: postgresql://user:password@localhost:5432/matriz_laft
DATABASE_URL=postgresql://user:password@localhost:5432/matriz_laft

# ── Sesiones (API Server) ──────────────────────────────────────────────────────
SESSION_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# ── Puertos ────────────────────────────────────────────────────────────────────
# El API server usa el valor de PORT; por defecto 8080 en local
PORT=8080
